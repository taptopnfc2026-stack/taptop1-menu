# Firebase Configuration
# Copy this file to .env and fill in your Firebase project values from the Firebase Console:
# https://console.firebase.google.com/

VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:abc123def456

# Optional: Use Firebase emulators for local development
# VITE_FIREBASE_USE_EMULATOR=true

# OpenAI / AI Configuration
# Option 1 (Recommended for production): Use Cloudflare Worker proxy to hide API key
#   Deploy the worker first, then set the proxy URL:
VITE_AI_PROXY_URL=https://taptop-menu-ai.your-subdomain.workers.dev
# Option 2 (Local dev only): Direct OpenAI API key
#   Get your API key at: https://platform.openai.com/api-keys
#   WARNING: Do NOT use Option 2 for production - API key will be exposed in browser!
VITE_OPENAI_API_KEY=sk-your-openai-key-here
